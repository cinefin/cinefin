{
	"name": "cinefin-spa",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"generate:schema": "cd ../backend && poetry run python manage.py export_openapi",
		"generate:types": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/types.gen.ts",
		"generate:api": "npm run generate:schema && npm run generate:types",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@lucide/svelte": "1.48.0",
		"openapi-fetch": "0.17.0"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"vite": "8.3.1"
	}
}
